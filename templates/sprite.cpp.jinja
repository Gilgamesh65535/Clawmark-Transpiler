#include "Scene.hpp"

void Register_Sprite{{ sprite_index }}(Scene& scene) {
    auto def = std::make_unique<Sprite>();
    def->name = "{{ target.name }}";
    {% for costume in target.costumes %}
    def->costumes.push_back({
        "{{ costume.name }}",
        {{ costume.bitmapResolution }},
        "{{ costume.dataFormat }}",
        "{{ costume.assetId }}",
        // "{{ costume.md5ext }}"
        {{ costume.rotationCenterX }},
        {{ costume.rotationCenterY }}
    });
    {% endfor %}

    auto inst = std::make_unique<RenderedTarget>();
    inst->sprite = def.get();  // Point back at definition
    inst->isStage             = {{ target.isStage | lower }};
    inst->x                   = {{ target.x }};
    inst->y                   = {{ target.y }};
    inst->size                = {{ target.size }};
    inst->direction           = {{ target.direction }};
    inst->visible             = {{ target.visible | lower }};
    inst->currentCostumeIndex = {{ target.currentCostume }};
    inst->rotationStyle = {% set rot = target.rotationStyle %}
        {% if rot == "all around" %}
            RotationStyle::ALL_AROUND
        {% elif rot == "left-right" %}
            RotationStyle::LEFT_RIGHT
        {% elif rot == "don't rotate" or rot == "dont rotate" %}
            RotationStyle::DONT_ROTATE
        {% else %}
            RotationStyle::ALL_AROUND
        {% endif %};
    // inst->layerOrder       = {{ target.layerOrder }};
    def->clones.push_back(std::move(inst));

    scene.AddSprite(std::move(def));
}